---
import { contact, site } from "../data/content";
---

<section id="contact" class="mx-auto max-w-6xl px-6 py-20 md:py-28">
  <div class="rounded-3xl border border-line bg-gradient-to-br from-bg-alt to-accent-soft/50 px-8 py-16 text-center sm:px-16">
    <h2 class="font-display text-3xl text-ink sm:text-4xl">{contact.heading}</h2>
    <p class="balance mx-auto mt-4 max-w-lg text-lg text-ink-soft">{contact.closing}</p>

    <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
      <a
        href={`mailto:${site.email}`}
        class="cursor-pointer rounded-full bg-accent px-7 py-3.5 text-sm font-semibold text-accent-ink shadow-lg shadow-accent/20 transition-transform duration-200 hover:scale-105"
      >
        {site.email}
      </a>
      <a
        href={site.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="cursor-pointer rounded-full border border-line px-7 py-3.5 text-sm font-semibold text-ink transition-colors duration-200 hover:border-accent hover:text-accent"
      >
        Connect on LinkedIn
      </a>
    </div>

    <p class="mt-8 text-sm text-ink-soft">
      {site.phone} · {site.location}
    </p>
  </div>
</section>
