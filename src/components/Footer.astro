---
import { getContent } from "../data/content";

const { site, ui } = getContent(Astro.currentLocale);
const year = new Date().getFullYear();
---

<footer class="border-t border-line px-6 py-10">
  <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-4 text-sm text-ink-soft sm:flex-row">
    <p>&copy; {year} {site.name}. {ui.footer.rights}</p>
    <a href="#top" class="cursor-pointer transition-colors duration-200 hover:text-accent">{ui.footer.backToTop}</a>
  </div>
</footer>
