---
import { Image } from "astro:assets";
import { getContent } from "../data/content";

const { education, site } = getContent(Astro.currentLocale);

// Certificate scans, shown as the card thumbnail where Tony has the file.
const certImages = import.meta.glob<{ default: ImageMetadata }>("../assets/certs/*.webp", {
  eager: true,
});

// Organisation logos: raster for AMI, inline SVG for the rest so they can be tinted.
const orgRaster = import.meta.glob<{ default: ImageMetadata }>("../assets/orgs/*.webp", {
  eager: true,
});
const orgSvg = import.meta.glob<string>("../assets/orgs/*.svg", {
  eager: true,
  query: "?raw",
  import: "default",
});

const certImage = (name?: string) =>
  name ? certImages[`../assets/certs/${name}.webp`]?.default : undefined;
const logoImage = (name?: string) =>
  name ? orgRaster[`../assets/orgs/${name}.webp`]?.default : undefined;
const logoSvg = (name?: string) => (name ? orgSvg[`../assets/orgs/${name}.svg`] : undefined);

// Simple Icons ship monochrome, so tint those marks with the brand's own colour.
// UOW's own SVG already carries its colours, so it is left alone.
const BRAND_TINT: Record<string, string> = {
  coursera: "#0056D2",
  adobe: "#FF0000",
  salesforce: "#00A1E0",
};
const tint = (name?: string) => (name && BRAND_TINT[name] ? `color: ${BRAND_TINT[name]}` : undefined);

// Falls back to initials when an institution blocks logo downloads (Macquarie).
const initials = (org: string) =>
  org
    .replace(/^(The|University of)\s+/i, "")
    .split(/\s+/)
    .map((word) => word[0])
    .join("")
    .slice(0, 3)
    .toUpperCase();
---

<section id="education" class="bg-bg-alt/60 py-20 md:py-28">
  <div class="mx-auto grid max-w-6xl gap-12 px-6 lg:grid-cols-[minmax(0,22rem)_1fr] lg:gap-16">
    <div class="lg:sticky lg:top-28 lg:self-start">
      <p class="font-display text-2xl text-highlight">{education.eyebrow}</p>
      <h2 class="mt-1 font-display text-3xl uppercase tracking-tight text-ink sm:text-4xl">
        {education.heading}
      </h2>
      <p class="mt-5 text-base leading-relaxed text-ink-soft">{education.intro}</p>

      <a
        href={site.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-7 inline-block cursor-pointer rounded-lg border-2 border-highlight px-6 py-3 text-sm font-semibold uppercase tracking-wide text-highlight transition-colors duration-200 hover:bg-highlight hover:text-highlight-ink"
      >
        {education.ctaLabel}
      </a>

      <div class="mt-10 border-t border-line pt-6">
        <h3 class="text-xs font-semibold uppercase tracking-wide text-ink-soft">
          {education.degreesLabel}
        </h3>
        <ul class="mt-4 space-y-4">
          {
            education.degrees.map((degree) => (
              <li class="flex items-start gap-3">
                <span class="flex h-9 w-9 shrink-0 items-center justify-center overflow-hidden rounded-lg bg-white p-1 ring-1 ring-line">
                  {logoSvg(degree.logo) ? (
                    <span
                      class="h-full w-full [&_svg]:h-full [&_svg]:w-full"
                      style={tint(degree.logo)}
                      set:html={logoSvg(degree.logo)}
                    />
                  ) : (
                    <span class="font-display text-[11px] text-[#10243a]">{initials(degree.org)}</span>
                  )}
                </span>
                <span>
                  <span class="block text-sm font-medium text-ink">{degree.title}</span>
                  <span class="block text-sm text-ink-soft">
                    {degree.org} · {degree.year}
                  </span>
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="grid gap-6 sm:grid-cols-2 xl:grid-cols-3">
      {
        education.certifications.map((cert) => (
          <article class="flex flex-col overflow-hidden rounded-2xl border border-line bg-surface">
            <div class="flex aspect-[4/3] items-center justify-center overflow-hidden border-b border-line bg-white p-3">
              {certImage(cert.image) ? (
                <Image
                  src={certImage(cert.image)!}
                  alt={`${cert.title} certificate`}
                  width={520}
                  class="h-full w-full rounded object-contain"
                />
              ) : logoImage(cert.logo) ? (
                <Image src={logoImage(cert.logo)!} alt={`${cert.org} logo`} width={320} class="max-h-16 w-auto" />
              ) : (
                <span
                  class="h-14 w-14 [&_svg]:h-full [&_svg]:w-full [&_path]:fill-current"
                  style={tint(cert.logo)}
                  set:html={logoSvg(cert.logo)}
                />
              )}
            </div>
            <div class="flex flex-1 flex-col p-5">
              <h3 class="text-sm font-semibold leading-snug text-ink">{cert.title}</h3>
              <p class="mt-auto pt-3 text-xs font-semibold uppercase tracking-wide text-highlight">{cert.org}</p>
              <p class="mt-1 text-xs text-ink-soft">{cert.year}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
