---
import { education } from "../data/content";
---

<section id="education" class="bg-bg-alt/60 py-20 md:py-28">
  <div class="mx-auto max-w-6xl px-6">
    <div class="max-w-2xl">
      <span class="text-xs font-semibold uppercase tracking-wide text-accent">Education & certifications</span>
      <h2 class="mt-3 font-display text-3xl text-ink sm:text-4xl">Always adding to the toolkit.</h2>
    </div>

    <div class="mt-12 grid gap-8 sm:grid-cols-2">
      <div class="rounded-2xl border border-line bg-surface p-7">
        <h3 class="font-display text-lg text-ink">Degrees</h3>
        <ul class="mt-5 space-y-5">
          {
            education.degrees.map((degree) => (
              <li>
                <p class="font-medium text-ink">{degree.title}</p>
                <p class="text-sm text-ink-soft">
                  {degree.org} · {degree.year}
                </p>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="rounded-2xl border border-line bg-surface p-7">
        <h3 class="font-display text-lg text-ink">Certifications</h3>
        <ul class="mt-5 space-y-5">
          {
            education.certifications.map((cert) => (
              <li>
                <p class="font-medium text-ink">{cert.title}</p>
                <p class="text-sm text-ink-soft">
                  {cert.org} · {cert.year}
                </p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
