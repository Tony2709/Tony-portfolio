---
import { Image } from "astro:assets";
import aboutPhoto from "../assets/tony-about.jpg";
import { about } from "../data/content";
---

<section id="about" class="mx-auto max-w-6xl px-6 py-20 md:py-28">
  <div class="grid gap-12 md:grid-cols-[1fr_1.3fr] md:gap-16">
    <div class="relative mx-auto w-full max-w-xs md:mx-0">
      <div class="absolute -inset-3 -z-10 rounded-3xl border border-line"></div>
      <Image
        src={aboutPhoto}
        alt="Tony Quang smiling, wearing a chambray shirt"
        width={480}
        class="h-auto w-full rounded-2xl object-contain shadow-xl"
      />
    </div>

    <div>
      <h2 class="font-display text-3xl text-ink sm:text-4xl">{about.heading}</h2>
      <div class="mt-6 space-y-5 text-base leading-relaxed text-ink-soft sm:text-lg">
        {about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
  </div>
</section>
