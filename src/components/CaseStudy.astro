---
import { Image } from "astro:assets";
import mjLogo from "../assets/mj-logo.png";
import mjHero from "../assets/mj-hero.webp";
import pantherLogo from "../assets/panther-logo.jpg";
import pantherHero from "../assets/panther-hero.webp";
import { getContent } from "../data/content";

const { caseStudies } = getContent(Astro.currentLocale);

const logos: Record<string, ImageMetadata> = {
  "MJ Health Nutrition & Fitness": mjLogo,
  "Panther Fit": pantherLogo,
};

const banners: Record<string, ImageMetadata> = {
  "MJ Health Nutrition & Fitness": mjHero,
  "Panther Fit": pantherHero,
};
---

<section id="case-study" class="mx-auto max-w-6xl px-6 py-20 md:py-28">
  <div class="space-y-24 md:space-y-32">
    {
      caseStudies.map((study) => (
        <article>
          <div class="max-w-3xl">
            <span class="text-xs font-semibold uppercase tracking-wide text-accent">{study.eyebrow}</span>
            <div class="mt-4 flex items-center gap-4">
              {logos[study.client] && (
                <div class="flex h-16 w-16 shrink-0 items-center justify-center overflow-hidden rounded-2xl bg-white p-1.5 ring-1 ring-line">
                  <Image
                    src={logos[study.client]}
                    alt={`${study.client} logo`}
                    width={128}
                    class="h-auto w-full rounded-xl object-contain"
                  />
                </div>
              )}
              <div>
                <h2 class="font-display text-3xl text-ink sm:text-4xl">
                  <a
                    href={study.clientHref}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="cursor-pointer transition-colors duration-200 hover:text-accent"
                  >
                    {study.client}
                  </a>
                </h2>
                <p class="mt-1 text-sm text-ink-soft">{study.clientMeta}</p>
              </div>
            </div>
            <p class="mt-6 text-lg leading-relaxed text-ink-soft">{study.summary}</p>
            <p class="mt-4 text-base leading-relaxed text-ink-soft">{study.context}</p>
          </div>

          {study.banner && banners[study.client] && (
            <div class="mt-10 overflow-hidden rounded-2xl border border-line">
              <Image
                src={banners[study.client]}
                alt={study.banner.alt}
                width={1200}
                class="h-auto w-full object-cover"
              />
            </div>
          )}

          <div class="mt-14 grid gap-10 lg:grid-cols-[1.6fr_1fr]">
            <div class="grid gap-5 sm:grid-cols-2">
              {study.deliverables.map((item, index) => (
                <div class="rounded-2xl border border-line bg-surface p-6">
                  <span class="font-display text-2xl text-accent">{String(index + 1).padStart(2, "0")}</span>
                  <h3 class="mt-3 text-base font-semibold text-ink">{item.title}</h3>
                  <p class="mt-2 text-sm leading-relaxed text-ink-soft">{item.description}</p>
                </div>
              ))}
            </div>

            <div class="flex flex-col rounded-2xl border border-line bg-bg-alt/70 p-6">
              <h3 class="font-display text-lg text-ink">{study.panel.heading}</h3>
              <p class="mt-1 text-sm text-ink-soft">{study.panel.sub}</p>
              {study.panel.type === "bars" ? (
                <div class="mt-6 space-y-5">
                  {study.panel.items.map((item) => (
                    <div>
                      <div class="flex items-center justify-between text-sm">
                        <span class="font-medium text-ink">{item.label}</span>
                        <span class="text-ink-soft">{item.value}/10</span>
                      </div>
                      <div class="mt-2 h-2 w-full overflow-hidden rounded-full bg-line">
                        <div class="h-full rounded-full bg-highlight" style={`width: ${(item.value ?? 0) * 10}%`} />
                      </div>
                    </div>
                  ))}
                </div>
              ) : (
                <ol class="mt-6 space-y-5">
                  {study.panel.items.map((item, index) => (
                    <li class="flex gap-4">
                      <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-highlight font-display text-sm text-highlight-ink">
                        {index + 1}
                      </span>
                      <div>
                        <p class="text-sm font-medium text-ink">{item.label}</p>
                        <p class="mt-0.5 text-sm text-ink-soft">{item.note}</p>
                      </div>
                    </li>
                  ))}
                </ol>
              )}

              {study.doc && (
                <a
                  href={study.doc.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group mt-8 block cursor-pointer rounded-xl border border-line bg-surface p-4 transition-colors duration-200 hover:border-accent"
                >
                  <span class="flex items-center gap-2.5">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="h-4.5 w-4.5 shrink-0 text-accent"
                    >
                      <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><path d="M14 2v6h6" />
                    </svg>
                    <span class="text-sm font-medium text-ink transition-colors duration-200 group-hover:text-accent">
                      {study.doc.label} ↗
                    </span>
                  </span>
                  <span class="mt-1.5 block text-xs leading-snug text-ink-soft">{study.doc.note}</span>
                </a>
              )}

              {study.siteCta && (
                <a
                  href={study.clientHref}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mt-4 flex cursor-pointer items-center justify-center gap-2 rounded-xl bg-highlight px-4 py-3 text-sm font-semibold text-highlight-ink transition-transform duration-200 hover:scale-[1.02]"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.9"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="h-4 w-4 shrink-0"
                  >
                    <circle cx="12" cy="12" r="9" /><path d="M3.6 9h16.8M3.6 15h16.8" /><path d="M12 3a15 15 0 0 1 0 18a15 15 0 0 1 0-18" />
                  </svg>
                  {study.siteCta.label} ↗
                </a>
              )}
            </div>
          </div>

        </article>
      ))
    }
  </div>
</section>
