---
import { caseStudy } from "../data/content";
---

<section id="case-study" class="mx-auto max-w-6xl px-6 py-20 md:py-28">
  <div class="max-w-3xl">
    <span class="text-xs font-semibold uppercase tracking-wide text-accent">{caseStudy.eyebrow}</span>
    <h2 class="mt-3 font-display text-3xl text-ink sm:text-4xl">{caseStudy.client}</h2>
    <p class="mt-2 text-xs italic text-ink-soft/70">{caseStudy.clientNote}</p>
    <p class="mt-6 text-lg leading-relaxed text-ink-soft">{caseStudy.summary}</p>
    <p class="mt-4 text-base leading-relaxed text-ink-soft">{caseStudy.context}</p>
  </div>

  <div class="mt-14 grid gap-10 lg:grid-cols-[1.6fr_1fr]">
    <div class="grid gap-5 sm:grid-cols-2">
      {
        caseStudy.deliverables.map((item, index) => (
          <div class="rounded-2xl border border-line bg-surface p-6">
            <span class="font-display text-2xl text-accent">{String(index + 1).padStart(2, "0")}</span>
            <h3 class="mt-3 text-base font-semibold text-ink">{item.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-soft">{item.description}</p>
          </div>
        ))
      }
    </div>

    <div class="rounded-2xl border border-line bg-bg-alt/70 p-6">
      <h3 class="font-display text-lg text-ink">Brand voice, scored</h3>
      <p class="mt-1 text-sm text-ink-soft">From the 10-page brand voice report.</p>
      <div class="mt-6 space-y-5">
        {
          caseStudy.voiceDimensions.map((dimension) => (
            <div>
              <div class="flex items-center justify-between text-sm">
                <span class="font-medium text-ink">{dimension.label}</span>
                <span class="text-ink-soft">{dimension.value}/10</span>
              </div>
              <div class="mt-2 h-2 w-full overflow-hidden rounded-full bg-line">
                <div
                  class="h-full rounded-full bg-accent"
                  style={`width: ${dimension.value * 10}%`}
                />
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
