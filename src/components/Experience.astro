---
import { experience } from "../data/content";
---

<section id="experience" class="mx-auto max-w-6xl px-6 py-20 md:py-28">
  <div class="max-w-2xl">
    <span class="text-xs font-semibold uppercase tracking-wide text-accent">Experience</span>
    <h2 class="mt-3 font-display text-3xl text-ink sm:text-4xl">Where I've done the work.</h2>
  </div>

  <div class="mt-12 space-y-10 border-l border-line pl-8">
    {
      experience.map((role) => (
        <div class="relative">
          <span class="absolute -left-[calc(2rem+5px)] top-1.5 h-2.5 w-2.5 rounded-full bg-accent ring-4 ring-bg" />
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <h3 class="font-display text-xl text-ink">{role.role}</h3>
            <span class="text-sm text-ink-soft">{role.period}</span>
          </div>
          <p class="text-sm font-medium text-accent">{role.company}</p>
          <ul class="mt-4 space-y-2.5">
            {role.points.map((point) => (
              <li class="flex gap-3 text-sm leading-relaxed text-ink-soft">
                <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-line" />
                <span>{point}</span>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>
