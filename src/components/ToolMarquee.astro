---
import { Image } from "astro:assets";
import { getContent } from "../data/content";

const { tools } = getContent(Astro.currentLocale);

// Monochrome marks (Simple Icons), tinted with each brand's own colour.
const icons = import.meta.glob<string>("../assets/tools/*.svg", {
  eager: true,
  query: "?raw",
  import: "default",
});

// Full colour brand logos supplied by Tony.
const logos = import.meta.glob<{ default: ImageMetadata }>("../assets/tools-brand/*.png", {
  eager: true,
});

const icon = (slug: string) => icons[`../assets/tools/${slug}.svg`] ?? "";
const logo = (file: string) => logos[`../assets/tools-brand/${file}.clean.png`]?.default;

// Two identical tracks sit side by side so the loop never shows a gap.
const track = [...tools.items, ...tools.items];
---

{/*
  The band keeps a light background in both themes on purpose: several of these
  logos are dark by design (Klaviyo, Claude, n8n, HubSpot's wordmark) and would
  disappear against the dark navy. A light strip lets every mark keep its real
  colours without boxing each one in its own tile.
*/}
<section aria-labelledby="tools-heading" class="border-y border-[#c0c0c0] bg-[#ebebeb] py-12 md:py-14">
  <div class="mx-auto max-w-6xl px-6">
    <h2 id="tools-heading" class="text-center text-xs font-semibold uppercase tracking-wide text-[#4d5b68]">
      {tools.heading}
    </h2>
  </div>

  <div class="marquee mt-8" role="list" aria-label={tools.heading}>
    <div class="marquee-track">
      {
        track.map((tool, index) => (
          <div
            role="listitem"
            aria-hidden={index >= tools.items.length ? "true" : undefined}
            class="flex shrink-0 items-center gap-3 px-8"
            title={tool.name}
          >
            {tool.file ? (
              <Image
                src={logo(tool.file)}
                alt={`${tool.name} logo`}
                height={40}
                densities={[1, 2]}
                class="h-10 w-auto"
              />
            ) : (
              <span
                class="h-10 w-10 shrink-0 [&_svg]:h-full [&_svg]:w-full [&_path]:fill-current"
                style={`color: ${tool.color}`}
                set:html={icon(tool.slug ?? "")}
              />
            )}
            {tool.label && (
              <span class="whitespace-nowrap text-base font-medium text-[#10243a]">{tool.name}</span>
            )}
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .marquee {
    overflow: hidden;
    /* Fade the edges so logos enter and leave softly rather than being cut. */
    mask-image: linear-gradient(to right, transparent, #000 7%, #000 93%, transparent);
    -webkit-mask-image: linear-gradient(to right, transparent, #000 7%, #000 93%, transparent);
  }

  .marquee-track {
    display: flex;
    align-items: center;
    width: max-content;
    animation: marquee-scroll 60s linear infinite;
  }

  .marquee:hover .marquee-track,
  .marquee:focus-within .marquee-track {
    animation-play-state: paused;
  }

  @keyframes marquee-scroll {
    from {
      transform: translateX(0);
    }
    to {
      /* Half the track is one full copy of the list. */
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee {
      overflow-x: auto;
    }
    .marquee-track {
      animation: none;
    }
  }
</style>
