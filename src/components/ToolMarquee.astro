---
import { getContent } from "../data/content";

const { tools } = getContent(Astro.currentLocale);

const icons = import.meta.glob<string>("../assets/tools/*.svg", {
  eager: true,
  query: "?raw",
  import: "default",
});

const icon = (slug: string) => icons[`../assets/tools/${slug}.svg`] ?? "";

// Brand colours are set for white backgrounds, so several marks (Elementor,
// WordPress, LinkedIn) go muddy on the dark navy. Lighten each one just enough
// to clear 3:1 against the dark background while staying recognisably on brand.
const DARK_BG = [0x05, 0x18, 0x2c];

const channels = (hex: string) =>
  [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16));

const luminance = (rgb: number[]) => {
  const [r, g, b] = rgb.map((v) => {
    const c = v / 255;
    return c <= 0.03928 ? c / 12.92 : Math.pow((c + 0.055) / 1.055, 2.4);
  });
  return 0.2126 * r + 0.7152 * g + 0.0722 * b;
};

const contrast = (a: number[], b: number[]) => {
  const [l1, l2] = [luminance(a), luminance(b)].sort((x, y) => y - x);
  return (l1 + 0.05) / (l2 + 0.05);
};

const onDark = (hex: string) => {
  let rgb = channels(hex);
  for (let step = 0; step < 20 && contrast(rgb, DARK_BG) < 3; step += 1) {
    rgb = rgb.map((v) => Math.round(v + (255 - v) * 0.12));
  }
  return "#" + rgb.map((v) => v.toString(16).padStart(2, "0")).join("");
};

// Two identical tracks sit side by side so the loop never shows a gap.
const track = [...tools.items, ...tools.items];
---

<section aria-labelledby="tools-heading" class="border-y border-line bg-bg-alt/50 py-12 md:py-16">
  <div class="mx-auto max-w-6xl px-6">
    <h2 id="tools-heading" class="text-center text-xs font-semibold uppercase tracking-wide text-ink-soft">
      {tools.heading}
    </h2>
  </div>

  <div class="marquee mt-8" role="list" aria-label={tools.heading}>
    <div class="marquee-track">
      {
        track.map((tool, index) => (
          <div
            role="listitem"
            aria-hidden={index >= tools.items.length ? "true" : undefined}
            class="flex shrink-0 items-center gap-4 px-8"
            title={tool.name}
          >
            <span
              class="h-12 w-12 shrink-0 text-[var(--tool-light)] dark:text-[var(--tool-dark)] [&_svg]:h-full [&_svg]:w-full [&_path]:fill-current"
              style={`--tool-light: ${tool.color}; --tool-dark: ${onDark(tool.color)}`}
              set:html={icon(tool.slug)}
            />
            <span class="whitespace-nowrap text-base font-medium text-ink-soft">{tool.name}</span>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .marquee {
    overflow: hidden;
    /* Fade the edges so logos enter and leave softly rather than being cut. */
    mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent);
    -webkit-mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent);
  }

  .marquee-track {
    display: flex;
    width: max-content;
    animation: marquee-scroll 42s linear infinite;
  }

  .marquee:hover .marquee-track,
  .marquee:focus-within .marquee-track {
    animation-play-state: paused;
  }

  @keyframes marquee-scroll {
    from {
      transform: translateX(0);
    }
    to {
      /* Half the track is one full copy of the list. */
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee {
      overflow-x: auto;
    }
    .marquee-track {
      animation: none;
    }
  }
</style>
